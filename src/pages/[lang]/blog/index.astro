---
import Layout from "@/layouts/Layout.astro";
import { getTranslations } from "@/i18n";
import {
  blogLocales,
  formatBlogDate,
  getBlogPosts,
  isBlogLocale,
} from "@/lib/blog";

export const getStaticPaths = () =>
  blogLocales.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;

if (!isBlogLocale(lang)) {
  return new Response("Not found", { status: 404 });
}

const t = getTranslations(lang);
const posts = await getBlogPosts(lang);
const canonical = Astro.site && new URL(`/${lang}/blog`, Astro.site);
const alternates = Astro.site
  ? blogLocales.map((locale) => ({
      lang: locale,
      href: new URL(`/${locale}/blog`, Astro.site),
    }))
  : [];
---

<Layout
  title={`${t.blogTitle} | ${t.siteTitle}`}
  description={t.blogDescription}
  {lang}
  {canonical}
  {alternates}
>
  <main class="blog-shell">
    <div class="blog-container">
      <header class="page-header">
        <a class="home-link" href={`/${lang}`}>
          {t.siteTitle}
        </a>
        <h1>{t.blogTitle}</h1>
        <p>{t.blogDescription}</p>
      </header>

      {
        posts.length === 0 ? (
          <p class="empty-message">{t.blogEmpty}</p>
        ) : (
          <ol class="post-list">
            {posts.map((post) => (
              <li>
                <article>
                  <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatBlogDate(post.data.pubDate, lang)}
                    </time>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <ul class="tag-list" aria-label="Tags">
                        {post.data.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <h2>
                    <a href={`/${lang}/blog/${post.data.slug}`}>
                      {post.data.title}
                    </a>
                  </h2>
                  <p>{post.data.description}</p>
                  <a class="read-more" href={`/${lang}/blog/${post.data.slug}`}>
                    {t.blogReadMore}
                  </a>
                </article>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </main>
</Layout>

<style>
  .blog-shell {
    min-height: 100svh;
    padding: clamp(32px, 7vw, 88px) 0;
    background:
      radial-gradient(
        circle at 18% 18%,
        hsl(28 100% 58% / 0.1),
        transparent 34%
      ),
      linear-gradient(135deg, #080a0f, #111827 48%, #0b1120);
  }

  .blog-container {
    width: min(100% - 32px, 900px);
    margin-inline: auto;
  }

  .page-header {
    display: grid;
    gap: 18px;
    margin-bottom: 56px;
  }

  .home-link,
  .read-more {
    color: #ff914d;
    font-weight: 700;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .page-header p,
  article > p,
  .empty-message {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .post-list {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  article {
    display: grid;
    gap: 16px;
    padding: clamp(20px, 4vw, 32px);
    border: 1px solid hsl(215 20% 76% / 0.18);
    border-radius: var(--radius-lg);
    background: hsl(220 30% 12% / 0.62);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.15;
  }

  h2 a:hover,
  h2 a:focus-visible {
    color: #ff914d;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 4px 8px;
    border: 1px solid hsl(215 20% 76% / 0.22);
    border-radius: 999px;
  }
</style>
