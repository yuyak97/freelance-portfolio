---
import BusinessCard from "@/components/BusinessCard.astro";
import gkImage from "@/assets/gk.png";
import type { Locale, TranslationSchema } from "@/i18n";

type Props = {
  locale: Locale;
  t: TranslationSchema;
};

const { locale, t } = Astro.props;
---

<main class="portfolio-shell" lang={locale}>
  <nav class="top-actions" aria-label="Language">
    <a class="locale-link" href={locale === "ja" ? "/en" : "/ja"}>
      {t.languageSwitchLabel}
    </a>
  </nav>

  <aside class="card-panel" aria-label="Profile card">
    <BusinessCard
      label={t.cardLabel}
      name={t.cardName}
      role={t.cardRole}
      skills={t.cardSkills}
      email={t.cardEmail}
    />
  </aside>

  <section class="content-panel" aria-label="Portfolio content">
    <section class="snap-section hero-section">
      <p class="eyebrow">{t.heroEyebrow}</p>

      <pre
        class="ascii-title"
        aria-label="Yuya K">
{`__  __                     __ __
\\ \\/ /_  ____  ______ _   / //_/
 \\  / / / / / / / __ \`/  / ,<   
 / / /_/ / /_/ / /_/ /  / /| |  
/_/\\__,_/\\__, /\\__,_/  /_/ |_|  
        /____/                  `}
</pre>

      <p class="lead">{t.heroLead}</p>

      <nav class="hero-links" aria-label="Primary links">
        <a href="#about">{t.heroLinkAbout}</a>
        <a href="#projects">{t.heroLinkProjects}</a>
        <a href="#publications">{t.heroLinkPublications}</a>
        <a href={`/${locale}/blog`}>{t.heroLinkBlog}</a>
        <a href="#contact">{t.heroLinkContact}</a>
        <a href="https://github.com/yuyak97" target="_blank" rel="noreferrer">
          {t.heroLinkGithub}
        </a>
      </nav>
    </section>

    <section class="snap-section" id="about">
      <p class="eyebrow">{t.aboutEyebrow}</p>
      <h2>{t.aboutTitle}</h2>
      <p>{t.aboutBody}</p>
      <p class="about-skills">{t.aboutSkills}</p>
    </section>

    <section class="snap-section" id="projects">
      <p class="eyebrow">{t.projectsEyebrow}</p>
      <h2>{t.projectsTitle}</h2>
      <p>{t.projectsBody}</p>

      <div class="project-list">
        <article class="project-card project-card-with-image">
          <div class="project-card-content">
            <p class="project-label">{t.projectTwoLabel}</p>
            <h3>{t.projectTwoTitle}</h3>
            <p>{t.projectTwoBody}</p>
            <p class="project-stack">{t.projectTwoStack}</p>
          </div>
          <img
            class="project-image"
            src={gkImage.src}
            alt={t.projectTwoImageAlt}
            width={gkImage.width}
            height={gkImage.height}
            loading="lazy"
          />
        </article>

        <article class="project-card">
          <p class="project-label">{t.projectOneLabel}</p>
          <h3>{t.projectOneTitle}</h3>
          <p>{t.projectOneBody}</p>
          <a
            class="text-link"
            href="https://github.com/yuyak97/react-native-websocket-self-signed"
            target="_blank"
            rel="noreferrer"
          >
            {t.projectOneLink}
          </a>
        </article>
      </div>
    </section>

    <section class="snap-section" id="publications">
      <p class="eyebrow">{t.publicationsEyebrow}</p>
      <h2>{t.publicationsTitle}</h2>
      <p>{t.publicationsBody}</p>

      <ul class="publication-list">
        <li>
          <span class="publication-meta">{t.publicationOneMeta}</span>
          <span class="publication-title">{t.publicationOneTitle}</span>
          <span class="publication-body">{t.publicationOneBody}</span>
          <a
            class="publication-link"
            href="https://amzn.asia/d/0hoHwLgb"
            target="_blank"
            rel="noreferrer"
          >
            {t.publicationOneLink}
          </a>
        </li>

        <li>
          <span class="publication-meta">{t.publicationTwoMeta}</span>
          <span class="publication-title">{t.publicationTwoTitle}</span>
          <span class="publication-body">{t.publicationTwoBody}</span>
          <a
            class="publication-link"
            href="https://amzn.asia/d/05O0mcx2"
            target="_blank"
            rel="noreferrer"
          >
            {t.publicationTwoLink}
          </a>
        </li>
      </ul>
    </section>

    <section class="snap-section" id="contact">
      <p class="eyebrow">{t.contactEyebrow}</p>
      <h2>{t.contactTitle}</h2>
      <p>{t.contactBody}</p>

      <nav class="quick-links" aria-label="Contact links">
        <a href="mailto:yuyakayama23@gmail.com">{t.contactLinkEmail}</a>
        <a href="https://github.com/yuyak97" target="_blank" rel="noreferrer">
          {t.contactLinkGithub}
        </a>
      </nav>
    </section>
  </section>
</main>

<style>
  .portfolio-shell {
    min-height: 100svh;
    background:
      radial-gradient(
        circle at 18% 18%,
        hsl(28 100% 58% / 0.13),
        transparent 34%
      ),
      radial-gradient(
        circle at 82% 72%,
        hsl(220 90% 60% / 0.12),
        transparent 34%
      ),
      linear-gradient(135deg, #080a0f, #111827 48%, #0b1120);
    color: #f8fafc;
  }

  .card-panel {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(42vw, 520px);
    display: grid;
    place-items: center;
    padding: 48px;
    pointer-events: none;
    perspective: 1000px;
  }

  .card-panel :global(.business-card) {
    pointer-events: auto;
  }

  .content-panel {
    margin-left: min(42vw, 520px);
    height: 100svh;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
  }

  .snap-section {
    min-height: 100svh;
    scroll-snap-align: start;
    display: grid;
    align-content: center;
    gap: 20px;
    padding: 80px min(8vw, 96px);
  }

  .top-actions {
    position: fixed;
    top: 32px;
    right: min(8vw, 96px);
    z-index: 10;
  }

  .locale-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid hsl(215 20% 76% / 0.26);
    border-radius: 999px;
    color: #f8fafc;
    background: hsl(220 30% 12% / 0.72);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    transition:
      transform 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease,
      color 0.16s ease;
  }

  .locale-link:hover,
  .locale-link:focus-visible {
    transform: translateY(-2px);
    border-color: #ff914d;
    color: #ff914d;
    background: hsl(28 100% 58% / 0.16);
    outline: none;
  }

  .eyebrow {
    margin: 0;
    color: #ff914d;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    max-width: 760px;
    font-size: 32px;
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .ascii-title {
    margin: 0;
    color: #ff914d;
    text-shadow: 0 0 5px currentColor;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.08;
    white-space: pre;
  }

  .lead {
    max-width: 640px;
    color: hsl(215 20% 76%);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 16px;
    line-height: 1.65;
    letter-spacing: 0.035em;
  }

  .snap-section > p:not(.eyebrow, .lead) {
    max-width: 640px;
    color: hsl(215 20% 76%);
    font-size: 16px;
    line-height: 1.75;
  }

  .snap-section > .about-skills {
    color: #f8fafc;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 700;
  }

  .hero-links,
  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .hero-links a,
  .quick-links a,
  .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid hsl(215 20% 76% / 0.26);
    border-radius: 999px;
    color: #f8fafc;
    background: hsl(220 30% 12% / 0.72);
    text-decoration: none;
    font-weight: 700;
    transition:
      transform 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease,
      color 0.16s ease;
  }

  .hero-links a:hover,
  .hero-links a:focus-visible,
  .quick-links a:hover,
  .quick-links a:focus-visible,
  .text-link:hover,
  .text-link:focus-visible {
    transform: translateY(-2px);
    border-color: #ff914d;
    color: #ff914d;
    background: hsl(28 100% 58% / 0.16);
    outline: none;
  }

  .project-list {
    display: grid;
    gap: 16px;
    max-width: 760px;
    margin-top: 24px;
  }

  .project-card {
    display: grid;
    gap: 14px;
    padding: 20px;
    border: 1px solid hsl(215 20% 76% / 0.18);
    border-radius: 20px;
    background: hsl(220 30% 12% / 0.62);
    backdrop-filter: blur(16px);
  }

  .project-card-with-image {
    display: flex;
    flex-direction: row;
    align-items: start;
    justify-content: space-between;
  }

  .project-image {
    flex: 0 0 auto;
    width: 104px;
    max-width: 100%;
    height: auto;
    border: 1px solid hsl(215 20% 76% / 0.18);
    border-radius: 12px;
  }

  .project-card-content {
    display: grid;
    min-width: 0;
    flex: 1;
    gap: 14px;
  }

  .project-label {
    color: #ff914d;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-card h3 {
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .project-card p:not(.project-label) {
    color: hsl(215 20% 76%);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .project-card .project-stack {
    color: #f8fafc;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .text-link {
    justify-self: start;
    margin-top: 6px;
  }

  .publication-list {
    display: grid;
    gap: 18px;
    max-width: 760px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .publication-list li {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    border-left: 2px solid #ff914d;
  }

  .publication-meta {
    color: #ff914d;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .publication-title {
    color: #f8fafc;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .publication-body {
    color: hsl(215 20% 76%);
    font-size: 1rem;
    line-height: 1.65;
  }

  .publication-link {
    justify-self: start;
    color: #f8fafc;
    font-size: 0.9rem;
    font-weight: 700;
    text-underline-offset: 4px;
    transition: color 0.16s ease;
  }

  .publication-link:hover,
  .publication-link:focus-visible {
    color: #ff914d;
    outline: none;
  }

  @media (max-width: 860px) {
    .portfolio-shell {
      min-height: 100svh;
    }

    .card-panel {
      position: relative;
      width: auto;
      min-height: 48svh;
      padding: 32px 20px 16px;
    }

    .content-panel {
      margin-left: 0;
      height: auto;
      overflow: visible;
      scroll-snap-type: none;
    }

    .snap-section {
      min-height: auto;
      scroll-snap-align: none;
      padding: 56px 24px;
    }

    .hero-section {
      position: relative;
      padding-top: 72px;
    }

    .top-actions {
      top: 24px;
      right: 24px;
    }

    .ascii-title {
      font-size: 10px;
      overflow-x: auto;
    }
  }

  @media (max-width: 420px) {
    .snap-section {
      padding-inline: 20px;
    }

    .top-actions {
      right: 20px;
    }

    .project-image {
      width: 120px;
    }
  }
</style>
